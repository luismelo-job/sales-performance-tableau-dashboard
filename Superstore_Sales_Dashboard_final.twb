    <worksheet name='KPI- Total Profit'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>Total Profit</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders++ (sample_-_superstore)' name='federated.0z268gl1kkuozh16yl1n60i010ag' />
          </datasources>
          <datasource-dependencies datasource='federated.0z268gl1kkuozh16yl1n60i010ag'>
            <column caption='Profit YoY %' datatype='real' name='[Calculation_1511860467683335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))}&#13;&#10;    THEN [Profit]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))} - 1&#13;&#10;    THEN [Profit]&#13;&#10;    END&#13;&#10;)&#13;&#10;) - 1' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column-instance column='[Profit]' derivation='Sum' name='[sum:Profit:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1511860467683335]' derivation='User' name='[usr:Calculation_1511860467683335:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.0z268gl1kkuozh16yl1n60i010ag].[sum:Profit:qk]' value='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' />
            <format attr='text-format' field='[federated.0z268gl1kkuozh16yl1n60i010ag].[usr:Calculation_1511860467683335:qk]' value='p0.0%' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0z268gl1kkuozh16yl1n60i010ag].[sum:Profit:qk]' />
              <text column='[federated.0z268gl1kkuozh16yl1n60i010ag].[usr:Calculation_1511860467683335:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontalignment='0'><![CDATA[<[federated.0z268gl1kkuozh16yl1n60i010ag].[sum:Profit:qk]>]]></run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0'>↑ </run>
                <run bold='true' fontalignment='0' fontcolor='#59a14f'><![CDATA[<[federated.0z268gl1kkuozh16yl1n60i010ag].[usr:Calculation_1511860467683335:qk]>]]></run>
                <run bold='true' fontalignment='0'>Æ </run>
