      <aliases enabled='yes' />
      <column caption='Profit Margin %' datatype='real' name='[Calculation_1511858775953408]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='IF SUM([Sales]) = 0 THEN&#13;&#10;0&#13;&#10;ELSE&#13;&#10;SUM([Profit]) / SUM([Sales])&#13;&#10;END' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_1511858776039425]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt; 0 THEN&#13;&#10;&quot;Profitable&quot;&#13;&#10;ELSEIF SUM([Profit]) &lt; 0 THEN&#13;&#10;&quot;Loss&quot;&#13;&#10;ELSE&#13;&#10;&quot;Break-even&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_1511858776117250]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
      <column caption='Discount Category' datatype='string' name='[Calculation_1511858776203267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] = 0 THEN&#13;&#10;&quot;No Discount&quot;&#13;&#10;&#13;&#10;ELSEIF [Discount] &lt;= 0.20 THEN&#13;&#10;&quot;Low Discount&quot;&#13;&#10;&#13;&#10;ELSEIF [Discount] &lt;= 0.50 THEN&#13;&#10;&quot;Medium Discount&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&quot;High Discount&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Shipping Time (Days)' datatype='integer' name='[Calculation_1511858776547332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption='Sales YoY %' datatype='real' name='[Calculation_1511860466540550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))}&#13;&#10;    THEN [Sales]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))} - 1&#13;&#10;    THEN [Sales]&#13;&#10;    END&#13;&#10;)&#13;&#10;) - 1' />
      </column>
      <column caption='Profit YoY %' datatype='real' name='[Calculation_1511860467683335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))}&#13;&#10;    THEN [Profit]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))} - 1&#13;&#10;    THEN [Profit]&#13;&#10;    END&#13;&#10;)&#13;&#10;) - 1' />
      </column>
      <column caption='Profit Margin YoY pp' datatype='real' name='[Calculation_1511860468789256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF YEAR([Order Date]) = 2026&#13;&#10;    THEN [Profit]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = 2026&#13;&#10;    THEN [Sales]&#13;&#10;    END&#13;&#10;)&#13;&#10;-&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = 2025&#13;&#10;    THEN [Profit]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF YEAR([Order Date]) = 2025&#13;&#10;    THEN [Sales]&#13;&#10;    END&#13;&#10;)&#13;&#10;* 100' />
      </column>
      <column caption='Month Year' datatype='string' name='[Calculation_1511860476669961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Order Date]) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [Order Date]))' />
      </column>
